<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>all you want — The Internet's Tech Collection</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    color: #fff;
    background: #050510;
    overflow-x: hidden;
}

/* =========================
   BACKGROUND
========================= */

body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -3;
    background:
        radial-gradient(circle at 15% 20%, rgba(111, 0, 255, .35), transparent 30%),
        radial-gradient(circle at 85% 25%, rgba(0, 217, 255, .25), transparent 30%),
        radial-gradient(circle at 50% 90%, rgba(255, 0, 153, .20), transparent 35%),
        linear-gradient(135deg, #050510, #0b0820 50%, #050510);
}

body::after {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -2;
    opacity: .15;
    background-image:
        linear-gradient(rgba(255,255,255,.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.06) 1px, transparent 1px);
    background-size: 45px 45px;
}

/* =========================
   NAVBAR
========================= */

.navbar {
    width: 100%;
    padding: 22px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 10;
}

.logo {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -1px;
}

.logo span {
    background: linear-gradient(90deg, #8b5cf6, #00e5ff, #ff4ecd);
    -webkit-background-clip: text;
    color: transparent;
}

.nav-link {
    color: #aaa9bd;
    text-decoration: none;
    font-size: 14px;
    padding: 10px 18px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 30px;
    transition: .3s;
}

.nav-link:hover {
    color: white;
    border-color: #8b5cf6;
    box-shadow: 0 0 25px rgba(139,92,246,.3);
}

/* =========================
   HERO
========================= */

.hero {
    min-height: 90vh;
    padding: 80px 7% 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
}

.hero-content {
    max-width: 950px;
}

.badge {
    display: inline-block;
    padding: 9px 18px;
    border: 1px solid rgba(255,255,255,.15);
    border-radius: 50px;
    background: rgba(255,255,255,.05);
    backdrop-filter: blur(15px);
    color: #c9c4ff;
    font-size: 13px;
    margin-bottom: 28px;
    box-shadow: 0 0 30px rgba(120,80,255,.15);
    animation: float 4s ease-in-out infinite;
}

.hero h1 {
    font-size: clamp(55px, 10vw, 110px);
    line-height: .95;
    letter-spacing: -6px;
    font-weight: 900;
    margin-bottom: 30px;
}

.gradient-text {
    background: linear-gradient(
        90deg,
        #ffffff,
        #a78bfa,
        #22d3ee,
        #f472b6,
        #ffffff
    );
    background-size: 300% auto;
    -webkit-background-clip: text;
    color: transparent;
    animation: gradientMove 6s linear infinite;
}

.hero p {
    max-width: 680px;
    margin: auto;
    color: #aaa9bd;
    font-size: 18px;
    line-height: 1.7;
}

.buttons {
    margin-top: 40px;
    display: flex;
    justify-content: center;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    text-decoration: none;
    padding: 16px 27px;
    border-radius: 14px;
    font-weight: 700;
    transition: .35s;
}

.btn-primary {
    color: #fff;
    background: linear-gradient(135deg, #7c3aed, #06b6d4);
    box-shadow:
        0 0 20px rgba(124,58,237,.35),
        0 0 50px rgba(6,182,212,.15);
}

.btn-primary:hover {
    transform: translateY(-5px) scale(1.03);
    box-shadow:
        0 0 30px rgba(124,58,237,.6),
        0 0 70px rgba(6,182,212,.25);
}

.btn-secondary {
    color: #fff;
    border: 1px solid rgba(255,255,255,.15);
    background: rgba(255,255,255,.04);
    backdrop-filter: blur(10px);
}

.btn-secondary:hover {
    transform: translateY(-5px);
    border-color: #8b5cf6;
}

/* =========================
   FLOATING GLOW ORBS
========================= */

.orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    pointer-events: none;
}

.orb-one {
    width: 120px;
    height: 120px;
    background: #7c3aed;
    opacity: .18;
    top: 18%;
    left: 8%;
    box-shadow: 0 0 100px 40px #7c3aed;
    animation: float 5s ease-in-out infinite;
}

.orb-two {
    width: 100px;
    height: 100px;
    background: #06b6d4;
    opacity: .15;
    right: 8%;
    bottom: 15%;
    box-shadow: 0 0 100px 40px #06b6d4;
    animation: float 6s ease-in-out infinite reverse;
}

/* =========================
   TECH MARQUEE
========================= */

.tech-strip {
    padding: 18px 0;
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,.07);
    border-bottom: 1px solid rgba(255,255,255,.07);
    background: rgba(255,255,255,.025);
}

.tech-track {
    display: flex;
    width: max-content;
    animation: marquee 25s linear infinite;
}

.tech-item {
    margin: 0 30px;
    color: #858398;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1px;
}

/* =========================
   SECTION
========================= */

.section {
    padding: 100px 7%;
}

.section-heading {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 55px;
}

.section-heading h2 {
    font-size: clamp(34px, 6vw, 58px);
    letter-spacing: -2px;
    margin-bottom: 15px;
}

.section-heading p {
    color: #9492a7;
    line-height: 1.7;
}

/* =========================
   CARDS
========================= */

.grid {
    max-width: 1150px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.card {
    position: relative;
    padding: 30px;
    min-height: 230px;
    border-radius: 24px;
    background:
        linear-gradient(
            145deg,
            rgba(255,255,255,.09),
            rgba(255,255,255,.025)
        );
    border: 1px solid rgba(255,255,255,.1);
    backdrop-filter: blur(18px);
    overflow: hidden;
    transition: .4s;
}

.card::before {
    content: "";
    position: absolute;
    width: 140px;
    height: 140px;
    top: -70px;
    right: -70px;
    border-radius: 50%;
    background: var(--glow);
    filter: blur(35px);
    opacity: .35;
}

.card:hover {
    transform: translateY(-9px);
    border-color: rgba(255,255,255,.25);
    box-shadow: 0 25px 60px rgba(0,0,0,.35);
}

.icon {
    width: 58px;
    height: 58px;
    border-radius: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    margin-bottom: 24px;
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.12);
    box-shadow: 0 0 30px var(--glow);
}

.card h3 {
    font-size: 22px;
    margin-bottom: 10px;
}

.card p {
    color: #9290a4;
    font-size: 14px;
    line-height: 1.65;
}

/* =========================
   FEATURED COLLECTION
========================= */

.collection {
    max-width: 1150px;
    margin: auto;
    display: grid;
    grid-template-columns: 1.3fr .7fr;
    gap: 20px;
}

.feature {
    min-height: 430px;
    padding: 40px;
    border-radius: 28px;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.1);
    background:
        radial-gradient(circle at 80% 20%, rgba(0,229,255,.2), transparent 30%),
        linear-gradient(145deg, rgba(124,58,237,.22), rgba(255,255,255,.025));
}

.feature h3 {
    font-size: 40px;
    max-width: 500px;
    margin-bottom: 18px;
}

.feature p {
    color: #aaa8ba;
    max-width: 500px;
    line-height: 1.7;
}

.tech-stack {
    position: absolute;
    bottom: 35px;
    left: 40px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.tech-pill {
    padding: 9px 14px;
    border-radius: 30px;
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.1);
    font-size: 12px;
    color: #c5c3d2;
}

.mini-column {
    display: grid;
    gap: 20px;
}

.mini-card {
    padding: 30px;
    border-radius: 24px;
    border: 1px solid rgba(255,255,255,.1);
    background: rgba(255,255,255,.035);
    transition: .35s;
}

.mini-card:hover {
    transform: scale(1.025);
    background: rgba(255,255,255,.06);
}

.mini-card strong {
    display: block;
    font-size: 28px;
    margin-bottom: 8px;
}

.mini-card span {
    color: #8e8c9e;
    font-size: 13px;
}

/* =========================
   CTA
========================= */

.cta {
    padding: 110px 7%;
    text-align: center;
}

.cta-box {
    max-width: 1000px;
    margin: auto;
    padding: 80px 30px;
    border-radius: 35px;
    border: 1px solid rgba(255,255,255,.12);
    background:
        radial-gradient(circle at 50% 0%, rgba(124,58,237,.35), transparent 45%),
        rgba(255,255,255,.035);
    box-shadow: 0 30px 100px rgba(0,0,0,.3);
}

.cta h2 {
    font-size: clamp(40px, 7vw, 70px);
    letter-spacing: -3px;
    margin-bottom: 20px;
}

.cta p {
    max-width: 600px;
    margin: auto;
    color: #9997aa;
    line-height: 1.7;
}

/* =========================
   FOOTER
========================= */

footer {
    padding: 35px 7%;
    border-top: 1px solid rgba(255,255,255,.07);
    text-align: center;
    color: #666476;
    font-size: 13px;
}

/* =========================
   ANIMATIONS
========================= */

@keyframes gradientMove {
    0% { background-position: 0% center; }
    100% { background-position: 300% center; }
}

@keyframes float {
    0%, 100% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-15px);
    }
}

@keyframes marquee {
    from {
        transform: translateX(0);
    }
    to {
        transform: translateX(-50%);
    }
}

/* =========================
   MOBILE
========================= */

@media (max-width: 850px) {

    .grid {
        grid-template-columns: 1fr 1fr;
    }

    .collection {
        grid-template-columns: 1fr;
    }

    .hero {
        min-height: 80vh;
        padding-top: 50px;
    }

    .hero h1 {
        letter-spacing: -4px;
    }
}

@media (max-width: 600px) {

    .navbar {
        padding: 18px 5%;
    }

    .nav-link {
        font-size: 12px;
        padding: 8px 13px;
    }

    .hero {
        padding: 60px 5% 80px;
    }

    .hero h1 {
        font-size: 54px;
        letter-spacing: -3px;
    }

    .hero p {
        font-size: 15px;
    }

    .section {
        padding: 75px 5%;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    .feature {
        min-height: 430px;
        padding: 30px;
    }

    .feature h3 {
        font-size: 32px;
    }

    .tech-stack {
        left: 30px;
        bottom: 30px;
        right: 20px;
    }

    .cta {
        padding: 70px 5%;
    }

    .cta-box {
        padding: 60px 22px;
    }
}
</style>
</head>

<body>

<!-- NAVIGATION -->

<nav class="navbar">
    <div class="logo">
        <span>all you want</span>
    </div>

    <a href="#explore" class="nav-link">
        Explore Collection →
    </a>
</nav>


<!-- HERO -->

<section class="hero">

    <div class="orb orb-one"></div>
    <div class="orb orb-two"></div>

    <div class="hero-content">

        <div class="badge">
            ✦ The internet's tech collection
        </div>

        <h1>
            Everything<br>
            <span class="gradient-text">you want.</span>
        </h1>

        <p>
            Discover a carefully organized collection of useful
            technologies, AI tools, websites, apps, resources and
            digital discoveries from across the internet.
        </p>

        <div class="buttons">
            <a href="#explore" class="btn btn-primary">
                Explore the collection →
            </a>

            <a href="#categories" class="btn btn-secondary">
                Browse categories
            </a>
        </div>

    </div>
</section>


<!-- MOVING TECH STRIP -->

<div class="tech-strip">

    <div class="tech-track">

        <div class="tech-item">AI TOOLS</div>
        <div class="tech-item">WEB APPS</div>
        <div class="tech-item">PRODUCTIVITY</div>
        <div class="tech-item">DESIGN</div>
        <div class="tech-item">DEVELOPMENT</div>
        <div class="tech-item">CREATIVE TOOLS</div>
        <div class="tech-item">AUTOMATION</div>
        <div class="tech-item">RESOURCES</div>

        <div class="tech-item">AI TOOLS</div>
        <div class="tech-item">WEB APPS</div>
        <div class="tech-item">PRODUCTIVITY</div>
        <div class="tech-item">DESIGN</div>
        <div class="tech-item">DEVELOPMENT</div>
        <div class="tech-item">CREATIVE TOOLS</div>
        <div class="tech-item">AUTOMATION</div>
        <div class="tech-item">RESOURCES</div>

    </div>
</div>


<!-- CATEGORIES -->

<section class="section" id="categories">

    <div class="section-heading">

        <h2>
            One place.<br>
            Endless possibilities.
        </h2>

        <p>
            From powerful AI platforms to underrated websites,
            discover technology that can help you create,
            learn, build and explore.
        </p>

    </div>


    <div class="grid">

        <div class="card" style="--glow:#8b5cf6;">
            <div class="icon">✦</div>
            <h3>AI & Intelligence</h3>
            <p>
                Explore AI assistants, image generators,
                writing tools, research platforms and more.
            </p>
        </div>


        <div class="card" style="--glow:#06b6d4;">
            <div class="icon">⌘</div>
            <h3>Productivity</h3>
            <p>
                Tools for organizing ideas, managing tasks,
                taking notes and getting more done.
            </p>
        </div>


        <div class="card" style="--glow:#f472b6;">
            <div class="icon">◇</div>
            <h3>Design</h3>
            <p>
                Discover platforms for graphics, UI design,
                presentations, images and creative work.
            </p>
        </div>


        <div class="card" style="--glow:#22c55e;">
            <div class="icon">⌁</div>
            <h3>Automation</h3>
            <p>
                Find tools that connect your apps and automate
                repetitive digital workflows.
            </p>
        </div>


        <div class="card" style="--glow:#f59e0b;">
            <div class="icon">◈</div>
            <h3>Development</h3>
            <p>
                Explore developer platforms, coding resources,
                APIs, hosting and useful web technologies.
            </p>
        </div>


        <div class="card" style="--glow:#ec4899;">
            <div class="icon">∞</div>
            <h3>Hidden Gems</h3>
            <p>
                Interesting websites and underrated digital
                resources you probably haven't discovered yet.
            </p>
        </div>

    </div>

</section>


<!-- FEATURED COLLECTION -->

<section class="section" id="explore">

    <div class="section-heading">

        <h2>
            Start exploring.
        </h2>

        <p>
            Your next favorite tool might be one click away.
        </p>

    </div>


    <div class="collection">

        <div class="feature">

            <h3>
                The ultimate digital toolbox.
            </h3>

            <p>
                A growing collection of technologies from across
                the internet — organized so you can spend less
                time searching and more time creating.
            </p>

            <div class="tech-stack">

                <span class="tech-pill">AI</span>
                <span class="tech-pill">Websites</span>
                <span class="tech-pill">Apps</span>
                <span class="tech-pill">Design</span>
                <span class="tech-pill">Coding</span>
                <span class="tech-pill">Automation</span>

            </div>

        </div>


        <div class="mini-column">

            <div class="mini-card">
                <strong>AI ✦</strong>
                <span>
                    Discover smarter ways to create and work.
                </span>
            </div>

            <div class="mini-card">
                <strong>Web ∞</strong>
                <span>
                    Find websites worth bookmarking.
                </span>
            </div>

            <div class="mini-card">
                <strong>Tools ◇</strong>
                <span>
                    Build your personal digital toolkit.
                </span>
            </div>

        </div>

    </div>

</section>


<!-- CTA -->

<section class="cta">

    <div class="cta-box">

        <h2>
            Find something<br>
            <span class="gradient-text">you'll love.</span>
        </h2>

        <p>
            Stop searching through endless tabs.
            Start discovering useful technology in one place.
        </p>

        <div class="buttons">

            <a href="#categories" class="btn btn-primary">
                Explore all you want →
            </a>

        </div>

    </div>

</section>


<!-- FOOTER -->

<footer>
    © 2026 all you want · Discover. Explore. Create.
</footer>

</body>
  </html>
